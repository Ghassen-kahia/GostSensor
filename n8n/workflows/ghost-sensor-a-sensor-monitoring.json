      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "id": "71d257c9-459a-440e-8886-77c90a5cde24",
      "name": "Claim Pending Incidents",
      "type": "n8n-nodes-base.httpRequest",
