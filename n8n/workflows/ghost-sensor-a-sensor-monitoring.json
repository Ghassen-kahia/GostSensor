        760,
        340
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBaseUrl }}/api/automation/detect",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendBody": true,
        "contentType": "json",
