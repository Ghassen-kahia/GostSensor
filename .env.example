# Ghost Sensor - configuration template. Copy to `.env` (never commit `.env`).
# Placeholders only: generate your own secrets, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---------------------------------------------------------------- data
# Folder with the raw exports (temperature_csv/, energy_csv/, the IFC and MSI files). Default: repo root.
# GHOST_SOURCE_DIR=C:/path/to/BOS
# Generated database, parquet files and models. Keep it OUT of OneDrive/Dropbox (SQLite WAL + sync = locks).
GHOST_DATA_DIR=C:/Users/<you>/AppData/Local/GhostSensor/data

# ---------------------------------------------------------------- API
# 0.0.0.0 so n8n inside WSL can reach the backend through the Windows host IP.
GHOST_HOST=0.0.0.0
GHOST_PORT=8000
GHOST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GHOST_DASHBOARD_URL=http://localhost:5173
# Operator actions (acknowledge/resolve, replay, simulated faults, reset). Entered in the dashboard sign-in.
GHOST_OPERATOR_TOKEN=<generate-a-random-token>
# n8n -> backend calls (header X-Ghost-Token). Put the same value in the n8n credential.
GHOST_AUTOMATION_TOKEN=<generate-another-random-token>
# Read endpoints without a token (local development). Set false to require the operator token for reads.
GHOST_ALLOW_ANONYMOUS_READ=true
GHOST_MAX_BODY_BYTES=524288
# Largest CSV accepted on the Data check page
GHOST_MAX_UPLOAD_MB=300

# ---------------------------------------------------------------- building clock
# REPLAY replays the historian (Jan-Jun 2026); LIVE uses wall-clock time + POST /api/ingest/measurements.
GHOST_DATA_MODE=REPLAY
GHOST_REPLAY_START=2026-03-02T06:00:00Z
GHOST_REPLAY_SPEED=60
GHOST_TICK_SECONDS=5
GHOST_BACKGROUND_ENGINE=true

# ---------------------------------------------------------------- orchestration
# n8n: agents 2-4 are driven by the n8n workflows; local: the backend runs them itself.
GHOST_ORCHESTRATION_MODE=n8n
# If n8n has not processed an incident version within this many seconds, the backend does it (never stranded).
GHOST_LOCAL_FALLBACK_AFTER_S=300
N8N_BASE_URL=http://localhost:5678
# Optional: lets the dashboard list n8n executions (n8n Settings > n8n API).
N8N_API_KEY=
# Optional: push new incident ids to Workflow A's webhook instead of waiting for its 1-minute poll.
# N8N_TRIGGER_WEBHOOK_URL=http://localhost:5678/webhook/ghost-sensor/incidents

# ---------------------------------------------------------------- LLM (optional)
# none | anthropic | openai_compatible. Agents are fully functional with "none".
LLM_PROVIDER=none
# anthropic: defaults to claude-opus-5-5; key may also come from the SDK's own credential resolution.
LLM_MODEL=
LLM_API_KEY=
# openai_compatible only (e.g. http://localhost:11434/v1 for Ollama)
LLM_BASE_URL=
LLM_TIMEOUT_S=45

# ---------------------------------------------------------------- email (Agent 4)
# test: write .eml files to <data>/outbox (status TEST_MODE, never "SENT"). smtp: real delivery.
EMAIL_MODE=test
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_FROM=
# Comma-separated
ALERT_RECIPIENTS=
ESCALATION_RECIPIENTS=
